<div style="display: flex; max-width: 100%; padding: 2px">
    <div style="max-width:100px; max-height: 100px">
        <img style="padding: 2px; max-width: 100px; max-height: 100px; object-fit: fill;" src="{{ img }}"  alt="feature_logo">
    </div>
    <div style="max-width:300px; max-height: 300px; display: flex; justify-content: space-between; display: flex; flex-direction: column;">
        <div>
            <h1 class="font-size: xx-large">{{ title }}</h1>
            <p class="margin-top: 20px;">{{ text }}</p>
        </div>
        <p class="margin-top: 20px;">{{ highlight }}</p>
    </div>
</div>
