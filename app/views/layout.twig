<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="img/JainzPixelArt.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <title>{% block title %}Aljamu Blog{% endblock %}</title>
    <style nonce="{{ csp_nonce }}">
        :root {

            --accent: #e94f37;
            --background: #ecf2fb;
            --primary-color: #393e41;

            --max-width: 1500px;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {

            font-family: "Noto Sans", Roboto, sans-serif;
            background: var(--background);
            color: var(--primary-color);
            line-height: 1.5;
            min-height: 100vh;
        }
        .content-wrapper {
            width: 80%;
            margin: auto;
            max-width: var(--max-width)
        }
        header {
            display: flex;
            gap: 1.5rem;
            align-items: center;
            background: var(--primary-color);
        }
        header nav { padding: 10px 0; height: 90px; width: 80%; max-width: var(--max-width); margin: auto; display: flex; justify-content: space-between; gap: 1rem; font-size: 0.95rem; }
        header img { width: 140px;}
        header a { padding-top: 20px; color: white; text-decoration: none; width: 150px; text-align: center; font-size: x-large;}
        header a:hover { color: var(--accent)}
        header .nav-elements { display: flex; flex-direction: row; justify-content: center; align-items: center;}
        main { margin: 0 auto;}
        .card {
            background: var(--accent);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 1.5rem;
            margin-bottom: 1rem;
        }
        footer{
            position: fixed; 
            bottom: 0;
            width: 100%;
            background-color: var(--accent);
        }
        footer p{
            width: 25%;
            margin: auto;
        }
        code {
            background: #0b1018;
            color: white;
            padding: 0.15rem 0.4rem;
            border-radius: 4px;
            font-size: 0.9em;
        }
        .logo-fixer{
            position: relative;
        }
        .logo{
            position: absolute;
        }

        nav img {
            width: 120px;
            border: var(--primary-color) 7px solid;
            border-radius: 50%;
            background-color: white;
            padding: 0px;
        }

        nav h1 {
                margin-top: 40px;
                color: white;
                margin-left: 118px;
                font-size: larger;
                font-weight: 100;
        }
    </style>
    {% block head %}{% endblock %}
</head>
<body>
    <header>
        <nav>
            <div class="logo-fixer">
                <a href="{{ base_url }}">
                    <img class="logo" src="img/JainzPixelArt.png" alt="Logo">
                </a>
                <h1>| BLOG</h1>
            </div>
            <div class="nav-elements">
                <a href="https://aljamu.de">Portfolio</a>
                <a href="{{ base_url }}food">Apps</a>
            </div>
        </nav>
    </header>
    <main>
        {% block body %}{% endblock %}
    </main>
    {% if env == "development" %}
    <footer>
        <p class="muted">
            Environment: <code>{{ env }}</code>
            · Debug: <code>{{ debug ? 'on' : 'off' }}</code>
        </p>
    </footer>
    {% endif %}
</body>
</html>
